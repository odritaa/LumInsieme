# Variables que consume docker-compose.yml. Copiar a .env en la raiz del repo.
# El .env no se commitea: el .gitignore de la raiz ignora *.env

POSTGRES_USER=luminsieme
POSTGRES_PASSWORD=
POSTGRES_DB=luminsieme

# Mismo valor que JWT_SECRET de src/login-controller/.env: reunion y chat validan con el.
JWT_SECRET=
FRONTEND_URL=http://localhost:5173

# Scrapper on-demand
# TTL de la cartelera en Redis: vencida, el feed queda vacio hasta el proximo scrape.
CACHE_TTL=86400
SCRAPPING_DAYS=5
