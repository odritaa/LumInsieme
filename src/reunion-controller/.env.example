# Copiar a .env y completar. El .env nunca se commitea.

# --- Servidor ---
PORT=4100
NODE_ENV=development

# --- PostgreSQL (la misma base que login-controller: las salas referencian users) ---
DATABASE_URL=postgres://luminsieme:CAMBIAR@localhost:5432/luminsieme

# --- Cache-controller (gRPC): de aca sale la cartelera scrapeada ---
CACHE_GRPC_ADDR=localhost:50051

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Sesion JWT: debe ser el mismo JWT_SECRET que usa login-controller ---
JWT_SECRET=
COOKIE_NAME=lum_session

# --- Zona horaria con la que se decide que salas ya pasaron ---
TIMEZONE=America/Argentina/Buenos_Aires
