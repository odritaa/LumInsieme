# Copiar a .env y completar. El .env nunca se commitea.

# --- Servidor ---
PORT=4002
NODE_ENV=development
LOG_LEVEL=debug
# Opcional: identifica la replica en logs y /salud. Si se omite se genera sola.
# INSTANCE_ID=chat-1

# --- PostgreSQL ---
DATABASE_URL=postgres://usuario:clave@localhost:5432/luminsieme
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=5000
PG_SSL=false

# --- Redis (cache y bus de eventos entre instancias) ---
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=luminsieme:chat
REDIS_MAX_RECIENTES=50
REDIS_TTL_RECIENTES_SEG=86400
REDIS_TTL_PRESENCIA_SEG=90

# --- Sesion JWT ---
# DEBE ser exactamente el mismo valor que el JWT_SECRET de login-controller.
JWT_SECRET=
COOKIE_NAME=lum_session
# JWT_ISSUER=
# JWT_AUDIENCE=

# --- CORS y origenes del WebSocket ---
CORS_ORIGINS=http://localhost:5173
# Si se omite, hereda CORS_ORIGINS.
# WS_ORIGINS=http://localhost:5173

# --- reunion-controller (validacion de evento_id) ---
# Si queda vacia NO se valida que el evento exista: util mientras el
# reunion-controller no este listo. Configurarla en produccion.
REUNION_SERVICE_URL=
REUNION_TIMEOUT_MS=2000

# --- Limites del chat ---
CHAT_MAX_MIEMBROS=50
CHAT_MAX_LONGITUD_MENSAJE=2000
CHAT_PAGINA_HISTORIAL=50
CHAT_PAGINA_HISTORIAL_MAX=100

# --- WebSocket ---
WS_PATH=/ws
WS_MAX_PAYLOAD_BYTES=16384
WS_HEARTBEAT_MS=30000
WS_MAX_BUFFER_BYTES=1048576
WS_MAX_CONEXIONES_POR_USUARIO=5
WS_MAX_SUSCRIPCIONES=20
WS_RATE_CAPACIDAD=10
WS_RATE_RECARGA=2

# --- Mantenimiento (purga de invitaciones) ---
MANTENIMIENTO_HABILITADO=true
MANTENIMIENTO_INTERVALO_MS=3600000
RETENCION_INVITACIONES_DIAS=30

# --- Apagado ordenado ---
SHUTDOWN_TIMEOUT_MS=10000
