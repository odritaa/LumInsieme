# Copiar a .env y completar. El .env nunca se commitea.

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- PostgreSQL ---
DATABASE_URL=postgres://luminsieme:CAMBIAR@localhost:5432/luminsieme

# --- Google OAuth 2.0 (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Sesion JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# --- Cookies ---
COOKIE_NAME=lum_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
